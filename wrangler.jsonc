{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-kontor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Protokolle im Cloudflare-Dashboard (Worker → Logs), hilft bei Fehlersuche
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Plattform-Datenbank: Firmen-Verzeichnis, Benutzer, Sitzungen
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "code-kontor-platform",
      "database_id": "ee9b3df8-be53-4e01-99ef-1dc933b4832e",
      "migrations_dir": "migrations"
    }
  ],
  // Eine eigene SQLite-Datenbank je Kunde (Durable Object je Firma)
  "durable_objects": {
    "bindings": [{ "name": "TENANT_DB", "class_name": "TenantDatabase" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDatabase"] }]
}
