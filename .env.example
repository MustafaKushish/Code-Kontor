# KI-Assistent (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# E-Mail-Versand (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Verschlüsselung für sensible Daten (IBAN, 2FA)
DATA_KEY=

# Stripe Billing (Abonnements)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lokale Entwicklung (wrangler dev ohne EU-Jurisdiktionseinschränkung)
LOCAL_NO_JURISDICTION=1
