/*
  Content-Security-Policy: default-src 'self' data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' *; font-src 'self' data:; img-src 'self' data: blob:; manifest-src 'self'; worker-src 'self' blob:; frame-ancestors *;
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=()
